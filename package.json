{
	"name": "pipertts",
	"version": "1.0.3",
	"description": "TypeScript wrapper for PiperTTS using python3 -m piper by default",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/**/*",
		"README.md",
		"prebuilds/**/*"
	],
	"type": "module",
	"scripts": {
		"build:watch": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"example": "ts-node --esm examples/example.ts",
		"format": "bunx --bun @biomejs/biome format --write ./src",
		"check": "bunx --bun @biomejs/biome check ./src",
		"lint": "bunx --bun @biomejs/biome lint ./src",
		"lint:write": "bunx --bun @biomejs/biome lint --write ./src",
		"test": "bunx --bun @biomejs/biome test ./src",
		"build": "tsc --project tsconfig.json",
		"deploy:npm": "npm publish --access public",
		"publish-package": "bash ./scripts/publish-package.sh",
		"bench": "rm -rf .benchmark-shells/ && bun benchmark-virtualshell.ts",
		"standalone-build": "bunx esbuild src/standalone.ts --bundle --platform=node --target=node18 --outfile=standalone.js --tree-shaking=true --minify --sourcemap",
		"build:espeak-bridge": "node-gyp rebuild",
		"prebuild": "prebuildify --napi --strip -n espeak_bridge"
	},
	"keywords": [
		"piper",
		"tts",
		"text-to-speech",
		"speech-synthesis"
	],
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itsrealfortune/pipertts.git"
	},
	"bugs": {
		"url": "https://github.com/itsrealfortune/pipertts/issues"
	},
	"homepage": "https://github.com/itsrealfortune/pipertts#readme",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"node-gyp": "^13.0.2",
		"prebuildify": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@breezystack/lamejs": "^1.2.7",
		"onnxruntime-node": "^1.20.0"
	},
	"binary": {
		"module_name": "espeak_bridge",
		"host": "https://github.com/itsrealfortune/pipertts/releases/download/",
		"remote_path": "{version}",
		"package_name": "{module_name}-v{version}-{napi_build_version}-{platform}-{arch}.tar.gz"
	}
}
